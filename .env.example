# OPENROUTER_API_KEY / OMNIROUTER_API_KEY: Optional OpenRouter / Omni Router AI Key for multi-provider Omni routing (Cohere, DeepSeek, GPT-4o Mini, Claude, etc.).
# Works as an automatic dual-key combo alongside GEMINI_API_KEY with zero-downtime failover.
OPENROUTER_API_KEY=
OMNIROUTER_API_KEY=
OMNI_ROUTER_API_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform place search and map rendering.
GOOGLE_MAPS_PLATFORM_KEY=

# RAZORPAY_KEY_ID: Razorpay Key ID for payments and subscriptions.
# Get this from your Razorpay Dashboard (Settings > API Keys).
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=

# RAZORPAY_KEY_SECRET: 24-character HMAC signing secret from Razorpay Dashboard.
RAZORPAY_KEY_SECRET=

# RAZORPAY_WEBHOOK_SECRET: Secret configured when creating webhooks in Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ADMIN_SECRET_KEY: Master password / secret for Acharya Manish Admin Portal access.
ADMIN_SECRET_KEY=
